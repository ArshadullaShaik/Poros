# Copy to deploy/.env ON THE SERVER; fill values through a secure transfer.
# Use the stable production Vercel domain, without a trailing slash.
MEMBERSHIP_ORIGIN=https://YOUR-PROJECT.vercel.app
BACKEND_HOST=YOUR-BACKEND-HOST
POROS_PROXY_SECRET=REPLACE_WITH_A_RANDOM_64_HEX_SECRET
PORT=8080
MEMBERSHIP_DB_PATH=/state/membership.sqlite
# Preserve these from the existing local installation; do not generate replacements.
MEMBERSHIP_MASTER_KEY=
MEMBERSHIP_RELAY_PRIVATE_KEY=
SWARM_BEE_URL=http://127.0.0.1:1633
SWARM_POSTAGE_BATCH_ID=
ARKIV_ACCESS_KEY=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
