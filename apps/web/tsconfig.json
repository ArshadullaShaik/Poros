{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node"],
    "allowImportingTsExtensions": true, "esModuleInterop": true, "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"], "exclude": ["dist", "node_modules"]
}
